{
  "name": "moor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm --filter moor-sidecar build && tsc -b && vp build",
    "preview": "vp preview",
    "tauri": "tauri",
    "sidecar": "pnpm --filter moor-sidecar dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm sidecar\"",
    "lint": "vp lint src sidecar/src",
    "lint:fix": "vp lint src sidecar/src --fix",
    "format": "vp fmt \"src/**/*.{ts,tsx,css}\" \"sidecar/src/**/*.ts\"",
    "format:check": "vp fmt --check \"src/**/*.{ts,tsx,css}\" \"sidecar/src/**/*.ts\"",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^0.469",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^9",
    "tailwindcss": "^4",
    "typescript": "~5.7",
    "vite-plus": "catalog:"
  }
}
